APP_NAME="HR Onboarding Agent"
APP_ENV=production
DEMO_MODE=true

DATABASE_URL="mysql+pymysql://<user>:<password>@<host>:3306/hr_onboarding?charset=utf8mb4"

GCP_PROJECT_ID="your-gcp-project-id"
CLOUDSQL_INSTANCE="your-gcp-project-id:us-east1:your-instance"
CLOUDSQL_DATABASE="hr_onboarding"
CLOUDSQL_USER="root"
CLOUDSQL_PASSWORD="your-password"
CLOUDSQL_HOST="your-db-host"
CLOUDSQL_PORT=3306

GCS_BUCKET_NAME="your-gcs-bucket-name"
VERTEX_LOCATION="us-central1"
VERTEX_GEMINI_MODEL="gemini-1.5-flash"
ENABLE_CLOUD_TRACE=True
ENABLE_CLOUD_LOGGING=True

ELASTIC_ENDPOINT=https://your-elastic-endpoint.aws.found.io:443
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX_ALIAS=policy_chunks

SECRET_KEY="your-secure-jwt-secret-key"
ALGORITHM="HS256"

